{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSenderPluginManifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)+$",
      "description": "Unique reverse-DNS style plugin identifier (e.g. com.sienci.corner-finder)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "Semantic versioning string"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the plugin"
    },
    "author": {
      "type": "string",
      "description": "Author or organization"
    },
    "engine": {
      "type": "string",
      "description": "gSender compatible version range (e.g. >=1.5.0)"
    },
    "wasm": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Relative path to the compiled .wasm binary"
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Relative path to main QML or HTML entry file"
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot"],
            "properties": {
              "slot": {
                "type": "string",
                "enum": ["tools-page", "tools-tab", "visualizer-overlay", "settings-section", "standalone"]
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "route": {
                "type": "string"
              },
              "requiresIdle": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "requestTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "parsers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,64}$" },
          "label": { "type": "string" },
          "mode": { "type": "string", "enum": ["line", "block"], "default": "line" },
          "match": { "$ref": "#/definitions/regex" },
          "begin": { "$ref": "#/definitions/regex" },
          "end": { "$ref": "#/definitions/regex" },
          "ignore": { "$ref": "#/definitions/regex" },
          "until": { "type": "string", "enum": ["ok", "error", "ok-or-error"] },
          "whenWorkflow": { "type": "string", "enum": ["any", "idle"], "default": "any" },
          "maxLines": { "type": "integer", "minimum": 1, "maximum": 500, "default": 64 },
          "timeout": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 2000 },
          "strict": { "type": "boolean", "default": false },
          "restartOnBegin": { "type": "boolean", "default": false },
          "emitPartial": { "type": "boolean", "default": true },
          "ignoreStatusReports": { "type": "boolean", "default": true }
        }
      }
    }
  },
  "definitions": {
    "regex": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["source"],
          "properties": { "source": { "type": "string" }, "flags": { "type": "string" } }
        }
      ]
    }
  }
}

      "units": "mm/min",
      "description": "Z-axis maximum rate. Used as G0 rapid rate.",
      "inputType": "number",
      "min": 10,
      "step": 10
    },
    {
      "setting": "$120",
      "message": "X-axis acceleration",
      "category": "Motors",
      "units": "mm/sec^2",

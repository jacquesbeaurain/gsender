{
  "id": "com.sienci.parser-demo",
  "name": "Parser Demo",
  "version": "1.0.0",
  "description": "Demonstrates regex parser definitions and telemetry event interception",
  "author": "Sienci Labs",
  "engine": ">=1.5.0",
  "wasm": {
    "entry": "bin/plugin.wasm"
  },
  "ui": {
    "entry": "ui/Main.qml",
    "contributions": [
      {
        "slot": "tools-page",
        "route": "parser-demo",
        "label": "Parser Demo",
        "icon": "file-text"
      }
    ]
  },
  "parsers": [
    {
      "id": "probe",
      "mode": "line",
      "match": "^\\[PRB:(?<x>[-\\d.]+),(?<y>[-\\d.]+),(?<z>[-\\d.]+):(?<success>[01])\\]"
    },
    {
      "id": "modal-state",
      "mode": "line",
      "match": "^\\[GC:(?<modes>[^\\]]+)\\]",
      "whenWorkflow": "idle"
    }
  ],
  "capabilities": {
    "requestTypes": [
      "machine:command",
      "machine:get:context"
    ],
    "topics": [
      "controller"
    ]
  }
}

{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug (Debug LibPack)",
      "description": "Needs a VS developer environment and GS_LIBPACK_DEBUG pointing at the Debug LibPack",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GS_LIBPACK_DIR": "$env{GS_LIBPACK_DEBUG}"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (Release LibPack)",
      "description": "Needs a VS developer environment and GS_LIBPACK_RELEASE pointing at the Release LibPack",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GS_LIBPACK_DIR": "$env{GS_LIBPACK_RELEASE}",
        "GS_USE_PCH": "OFF"
      }
    },
    {
      "name": "vs-debug",
      "displayName": "Visual Studio 2026 Debug (Debug LibPack)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "GS_LIBPACK_DIR": "$env{GS_LIBPACK_DEBUG}"
      }
    },
    {
      "name": "vs-release",
      "displayName": "Visual Studio 2026 Release (Release LibPack)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "GS_LIBPACK_DIR": "$env{GS_LIBPACK_RELEASE}",
        "GS_USE_PCH": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "vs-debug", "configurePreset": "vs-debug", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs-release", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "ninja-debug", "inherits": "test-base", "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "inherits": "test-base", "configurePreset": "ninja-release" },
    { "name": "vs-debug", "inherits": "test-base", "configurePreset": "vs-debug", "configuration": "Debug" },
    { "name": "vs-release", "inherits": "test-base", "configurePreset": "vs-release", "configuration": "RelWithDebInfo" }
  ]
}
